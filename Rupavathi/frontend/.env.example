# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real credentials.
# Vite only exposes vars prefixed with VITE_ to client code.

# Base URL of the backend API. Locally this is the FastAPI dev server;
# in production, use your deployed backend's URL.
VITE_API_BASE_URL=http://localhost:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# (Application type: Web application). Add http://localhost:5173 as an
# authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, Identifiers & Profiles -> Identifiers -> Services ID
# Must match the backend's APPLE_SERVICES_ID exactly.
VITE_APPLE_SERVICES_ID=

# The exact Return URL you registered for the Services ID in Apple's console
# (must be HTTPS in production; Apple does not allow localhost for this).
VITE_APPLE_REDIRECT_URI=
