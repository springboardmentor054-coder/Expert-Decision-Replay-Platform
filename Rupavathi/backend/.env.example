# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# PostgreSQL connection string. Locally this points at your own Postgres
# instance; in production, use the connection string your host provides.
DATABASE_URL=postgresql://postgres:rupa@localhost:5432/expert_decision_replay_db

# Secret used to sign JWT auth tokens. Generate a strong random value for
# production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Locally this is the Vite dev server; add your deployed frontend URL too.
CORS_ORIGINS=http://localhost:5173

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# (Application type: Web application). No client secret needed here.
GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, Identifiers & Profiles -> Identifiers -> Services ID
# This is the Services ID string itself (looks like a reverse-domain, e.g. com.example.edrp.web)
APPLE_SERVICES_ID=
