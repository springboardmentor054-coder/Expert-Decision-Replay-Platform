# Environment file for Docker Compose
# Copy this to .env and adjust values as needed

# Database Configuration
# For SQLite (local development):
DATABASE_URL=sqlite:///./dev.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/database_name
# POSTGRES_USER=edp_user
# POSTGRES_PASSWORD=edp_password
# POSTGRES_DB=expert_decision_replay
# DB_PORT=5432

# Backend Configuration
BACKEND_PORT=8000
SESSION_SECRET=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
