# Expert Decision Replay Platform - Environment Configuration Template

# --------------------------------------------------
# Backend API Configuration
# --------------------------------------------------
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="Expert Decision Replay Platform"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="supersecretkeyforjwttokengenerationthatisverylong123456"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection
# SQLite default:
DATABASE_URL="sqlite:///./decisions.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/decision_replay_db"

# File Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760  # 10 MB limit

# --------------------------------------------------
# Frontend Web Workspace Configuration
# --------------------------------------------------
FLASK_PORT=5000
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"
# For Docker deployment:
# BACKEND_API_URL="http://backend:8000/api/v1"
